{
  "name": "dims",
  "displayName": "dims",
  "description": "Tensor, array and DataFrame shapes right in the Python debugger's Variables view (PyTorch, NumPy, pandas, TensorFlow)",
  "version": "0.1.8",
  "publisher": "provaznik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marekprovaznik/dims"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Data Science",
    "Machine Learning"
  ],
  "keywords": [
    "debug",
    "debugger",
    "debugging",
    "variables",
    "shape",
    "shapes",
    "tensor",
    "tensors",
    "array",
    "arrays",
    "ndarray",
    "numpy",
    "pytorch",
    "torch",
    "tensorflow",
    "jax",
    "pandas",
    "dataframe",
    "dimensions",
    "size",
    "debugpy",
    "python",
    "machine learning",
    "deep learning",
    "data science"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onDebugResolve:debugpy",
    "onDebugResolve:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "dims",
      "properties": {
        "dims.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable shape display in debug variables view"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "demo": "npm run compile && node ./out/test/demo/recordDemo.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "typescript": "^5.3.0"
  },
  "homepage": "https://github.com/marekprovaznik/dims#readme",
  "sponsor": {
    "url": "https://buymeacoffee.com/provaznik"
  },
  "bugs": {
    "url": "https://github.com/marekprovaznik/dims/issues"
  }
}
